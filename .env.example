# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign JWT/HMAC authentication tokens.
SESSION_SECRET="replace-with-a-secure-64-char-random-hex-secret-in-production"

# OTP_DEV_MODE: Set to "true" for local development (displays OTP on screen & console).
# Set to "false" in production when using a real SMS/Email provider.
OTP_DEV_MODE="true"

# OTP_PROVIDER: "dev" | "twilio" | "msg91" | "sendgrid"
OTP_PROVIDER="dev"

# Optional Twilio SMS configuration (when OTP_PROVIDER="twilio")
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional MSG91 SMS configuration (when OTP_PROVIDER="msg91")
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Optional SendGrid Email configuration (when OTP_PROVIDER="sendgrid")
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="no-reply@planease.app"
