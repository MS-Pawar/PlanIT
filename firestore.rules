rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation blueprint for UserProfile (/users/{userId})
    function isValidUserProfile(data) {
      return data.keys().hasAll(['ownerId', 'name', 'identifier', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'identifier', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.identifier is string
        && data.identifier.size() >= 3
        && data.identifier.size() <= 180
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation blueprint for PlannerWorkspace (/workspaces/{userId})
    function isValidPlannerWorkspace(data) {
      return data.keys().hasAll(['ownerId', 'currency', 'theme', 'payloadJson', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'currency', 'theme', 'payloadJson', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.currency is string
        && data.currency.size() == 3
        && (data.currency == 'INR' || data.currency == 'USD' || data.currency == 'EUR' || data.currency == 'GBP' || data.currency == 'AED' || data.currency == 'SGD')
        && data.theme is string
        && data.theme.size() >= 4
        && data.theme.size() <= 5
        && (data.theme == 'light' || data.theme == 'dark')
        && data.payloadJson is string
        && data.payloadJson.size() >= 2
        && data.payloadJson.size() <= 900000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'identifier', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /workspaces/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidPlannerWorkspace(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidPlannerWorkspace(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['currency', 'theme', 'payloadJson', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
